rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User private data subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Cases collection: doctors can access their own cases
    match /cases/{caseId} {
      allow read, update, delete: if request.auth != null && (
        resource == null || 
        resource.data.doctor_id == request.auth.uid || 
        resource.data.doctorId == request.auth.uid || 
        resource.data.user_id == request.auth.uid
      );
      allow create: if request.auth != null;
    }
    
    // Patients collection: doctors can access their own patients
    match /patients/{patientId} {
      allow read, update, delete: if request.auth != null && (
        resource == null || 
        resource.data.doctor_id == request.auth.uid || 
        resource.data.doctorId == request.auth.uid || 
        resource.data.user_id == request.auth.uid
      );
      allow create: if request.auth != null;
    }
    
    // Analysis reports
    match /analysis_reports/{reportId} {
      allow read, update, delete: if request.auth != null && (
        resource == null || 
        resource.data.doctor_id == request.auth.uid || 
        resource.data.user_id == request.auth.uid
      );
      allow create: if request.auth != null;
    }
    
    // Analyses collection
    match /analyses/{analysisId} {
      allow read, update, delete: if request.auth != null && (
        resource == null || 
        resource.data.doctor_id == request.auth.uid || 
        resource.data.user_id == request.auth.uid
      );
      allow create: if request.auth != null;
    }
    
    // Images collection
    match /images/{imageId} {
      allow read, write: if request.auth != null;
    }
  }
}
